{
  "name": "mini-ria-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@types/node": "^24.0.0",
      "@typescript/native-preview": "7.0.0-dev.20260421.2",
      "oxfmt": "0.48.0",
      "oxlint": "1.63.0",
      "oxlint-tsgolint": "^0.22.1",
      "vite": "^8.0.11",
      "zod": "^4.4.3",
      "zustand": "^5.0.13"
    }
  },
  "scripts": {
    "dev": "cd apps/demo && bun run dev",
    "build": "cd packages/ria && bun run build && cd ../../apps/demo && bun run build",
    "typecheck": "cd packages/ria && bun run typecheck && cd ../../apps/demo && bun run typecheck",
    "lint": "oxlint . --type-aware --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
