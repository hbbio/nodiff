/*
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://jsonplaceholder.typicode.com; img-src 'self' data: blob:; font-src 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
